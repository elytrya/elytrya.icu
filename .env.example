# View counter storage (persistent, works on Vercel).
# The API auto-detects whichever of these is present.
#
# Vercel "Redis" / Redis Cloud integration -> injects a TCP connection string:
REDIS_URL=
#
# Upstash / Vercel KV (REST) -> injects a REST url + token:
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
