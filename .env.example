# View counter storage (persistent, works on Vercel).
# Create a KV/Redis store, then set these. The API reads either naming pair.
#
# Option A - Vercel: Dashboard -> Storage -> create "Upstash for Redis".
# Vercel injects these automatically into the project:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# Option B - Upstash directly (console.upstash.com):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
